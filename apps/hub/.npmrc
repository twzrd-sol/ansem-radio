# Install policy for apps/hub (see README "Dependencies"):
# - no install scripts run, versions are exact;
# - peers are not auto-installed: @solana-mobile/wallet-standard-mobile depends on React Native's async-storage,
#   whose react-native peer would add ~300 packages the web build never imports (only its react-native entry does).
ignore-scripts=true
save-exact=true
legacy-peer-deps=true
fund=false
